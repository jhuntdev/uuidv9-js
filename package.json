{
  "name": "uuid-v9",
  "version": "1.0.1",
  "description": "Fast, lightweight, zero-dependency JavaScript/TypeScript implementation of UUID version 9",
  "homepage": "https://uuidv9.jhunt.dev",
  "keywords": [
    "uuid",
    "uuid-v9",
    "uuidv9",
    "uuid9",
    "prefix",
    "sequential",
    "non-sequential",
    "timestamp",
    "checksum",
    "crc",
    "javascript",
    "typescript",
    "nodejs",
    "node.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhuntdev/uuid-v9.git"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "mocha ./test"
  },
  "author": "JHunt <mail+uuidv9@jhunt.dev>",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "mocha": "^11.7.5",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
